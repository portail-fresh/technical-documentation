        term:FHT8044 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Pédiatrie'@fr , 'Paediatrics'@en ;
        

            skos:definition 'Spécialité médicale concernant le maintien en santé et les soins médicaux aux enfants de la naissance à l\'adolescence. '@fr, 'A medical specialty concerned with maintaining health and providing medical care to children from birth to adolescence.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/bf8aaaac-ddee-41cd-bb8a-c5a63de3fcbd' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D010372' ;
                            

