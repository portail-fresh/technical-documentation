        term:FHT6839 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Ophtalmologie'@fr , 'Ophthalmology'@en ;
        

            skos:definition 'Spécialité médicale concernant la structure et la fonction de l\'œil et le traitement médical et chirurgical de ses défauts et maladies.'@fr, 'A medical specialty concerned with the structure and function of the eye and the medical and surgical treatment of its defects and diseases.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/621ef1ce-2ebd-43d9-a6c7-ecd962d27269' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D009885' ;
                            

