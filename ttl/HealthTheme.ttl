        term:FHT6308 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Rhumatologie'@fr , 'Rheumatology'@en ;
        

            skos:definition 'Spécialité médicale concernant l\'étude des processus inflammatoires ou dégénératifs et du désordre métabolique des structures du tissu conjonctif, ce qui concerne une variété de troubles de l\'appareil locomoteur, tels que l\'arthrite.'@fr, 'A medical specialty concerned with the study of inflammatory or degenerative processes and metabolic derangement of connective tissue structures which pertain to a variety of musculoskeletal disorders, such as arthritis.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/bfb0bafd-7894-45ba-84fc-ddab5fd6c537' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D012219' ;
                            

        dct:identifier 'FHT6308' .
    

        term:FHT9410 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Santé publique, environnementale et du travail'@fr , 'Public, environmental and occupational health'@en ;
        

            skos:definition 'Domaine d’étude visant à prévenir les maladies, promouvoir la santé et protéger les populations face aux risques sanitaires d’origine collective, environnementale ou professionnelle, en analysant le rôle des facteurs environnementaux dans les effets néfastes sur la santé humaine et les moyens de les reconnaître et de les prévenir.'@fr, 'A field of study aimed at preventing disease, promoting health and protecting populations from collective, environmental or occupational health risks by analysing the role of environmental factors in adverse effects on human health and ways of recognising and preventing them.'@en ;
        

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/b533acc2-aff1-4c65-80ca-5d5bee865ba9' ;
                            

