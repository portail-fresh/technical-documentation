        term:FHT6579 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Addictologie'@fr , 'Addiction medicine'@en ;
        

            skos:definition 'Spécialité médicale qui se concentre sur le diagnostic et le traitement des troubles du comportement addictif, y compris les troubles liés aux substances et les troubles du contrôle des impulsions, ainsi que sur la gestion des conditions médicales et psychiatriques concomitantes.'@fr, 'A medical specialty focused on the diagnosis and treatment of addictive behavior disorders, including substance-related disorders and impulse control disorders, as welle as managing co-occurring medical and psychiatric conditions.'@en ;
        

            skos:exactMatch 'http://id.nlm.nih.gov/mesh/D000073316' ;
            

            skos:closeMatch 'http://data.europa.eu/8mn/euroscivoc/42d645e0-f58d-40ed-9917-5b227ff41a92' ;
        

        dct:identifier 'FHT6579' .
    

        term:FHT6478 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Allergologie'@fr , 'Allergology'@en ;
        

            skos:definition 'Spécialité médicale qui étudie, diagnostique et traite les maladies causées par les allergies.'@fr, 'The medical speciality that studies, diagnoses and treats diseases caused by allergies.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/af65e2bf-afc5-45e8-a0fc-364dfb48f0a4' ;
            

            skos:broadtMatch 'http://id.nlm.nih.gov/mesh/D000486' ;
        

        dct:identifier 'FHT6478' .
    

        term:FHT8575 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Andrologie et urologie'@fr , 'Andrology and urology'@en ;
        

            skos:definition 'Spécialité médicale concernant l\'étude de la biologie reproductive masculine, les maladies des organes génitaux masculins et l\'infertilité masculine. / Spécialité médicale concernant l\'étude, le diagnostic et le traitement des maladies des voies urinaires chez les deux sexes et les voies génitales masculines.'@fr, 'A medical discipline concerning the study of male reproductive biology, diseases of the male genital organs, and male infertility. / A specialty concerned with the study, diagnosis, and treatment of diseases of the urinary tract in both sexes, and the genital tract in the male.'@en ;
        

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/7341b8bd-fcb0-44c1-9ca9-8752b542ed59' ;
                            

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/d90d8dbf-c4b3-46c0-bf2c-55a4a3d9ba8b' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D033441' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D014572' ;
                            

        dct:identifier 'FHT8575' .
    

        term:FHT6307 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Anesthésiologie'@fr , 'Anaesthesiology'@en ;
        

            skos:definition 'Spécialité concernée par l\'étude des anesthésiques et de l\'anesthésie.'@fr, 'A specialty concerned with the study of anesthetics and anesthesia.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/e92e8adc-8256-4a4c-a052-b3cad420db7d' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D000776' ;
                            

        dct:identifier 'FHT6307' .
    

        term:FHT4041 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Cardiologie et médecine vasculaire'@fr , 'Cardiology and vascular medicine'@en ;
        

            skos:definition 'Branche de la médecine concernée par les troubles du cœur et le système cardiovasculaire.'@fr, 'The branch of medicine concerned with disorders of the heart and the cardiovascular system.'@en ;
        

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/4455c187-2f2f-4cd1-a4dd-449f59d73b39' ;
                            

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/c42fc6ec-b216-4a24-9e9d-f5e781c175a0' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D002309' ;
                            

        dct:identifier 'FHT4041' .
    

        term:FHT9233 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Chirurgie'@fr , 'Surgery'@en ;
        

            skos:definition 'Spécialité dans laquelle des procédures chirurgicales sont utilisées dans le traitement des maladies, des blessures ou des déformations.'@fr, 'A specialty in which operative procedures are used in the treatment of disease, injuries, or deformities.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/432746d6-998b-431f-b22f-d3abe0e8aada' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D013502' ;
                            

        dct:identifier 'FHT9233' .
    

        term:FHT5992 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Dermatologie'@fr , 'Dermatology'@en ;
        

            skos:definition 'Spécialité médicale concernant la peau, sa structure, ses fonctions, ses maladies et son traitement.'@fr, 'A medical specialty concerned with the skin, its structure, functions, diseases, and treatment.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/5375c411-6db9-40ed-a854-6554102a587b' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D003880' ;
                            

        dct:identifier 'FHT5992' .
    

        term:FHT5554 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Endocrinologie'@fr , 'Endocrinology'@en ;
        

            skos:definition 'Spécialité médicale concernant le métabolisme, la physiologie et les troubles du système endocrinien.'@fr, 'A medical specialty concerned with the metabolism, physiology, and disorders of the endocrine system.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/d1dd1bac-5313-4ab3-837f-4acd3ec521a7' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D004704' ;
                            

        dct:identifier 'FHT5554' .
    

        term:FHT2954 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Ethique médicale'@fr , 'Medical ethics'@en ;
        

            skos:definition 'Domaine d\'étude sur les principes de déontologie du médecin, les relations avec les patients et les confrères, ainsi que les actions du médecin dans les soins aux patients et les relations interpersonnelles avec les familles des patients.'@fr, 'The field of study focused on the principles of professional conduct of the physician, relations with patients and fellow practitioners, as well as actions of the physician in patient care and interpersonal relations with patient families.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/cbb6f86d-b5c6-4649-9b06-3712653ca459' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D004989' ;
                            

        dct:identifier 'FHT2954' .
    

        term:FHT2800 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Gastroentérologie'@fr , 'Gastroenterology'@en ;
        

            skos:definition 'Spécialité médicale concernant l\'étude de la physiologie et des maladies du système digestif.'@fr, 'A medical specialty concerned with the study of the physiology and diseases of the digestive system.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/a3898340-a42d-4f5e-a822-1de204a9a867' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D005762' ;
                            

        dct:identifier 'FHT2800' .
    

        term:FHT5098 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Génétique médicale'@fr , 'Medical genetics'@en ;
        

            skos:definition 'Spécialité médicale qui étudie l’hérédité chez l’homme et les causes génétiques des maladies, leur caractère héréditaire, leur transmission au fil des générations et leurs variations.'@fr, 'A medical specialty that studies heredity in humans and the genetic causes of diseases, their hereditary nature, their transmission across generations, and their variations.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/8e2d297f-5880-4d7a-969d-79026aa0779c' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D005823' ;
                            

        dct:identifier 'FHT5098' .
    

        term:FHT7111 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Gériatrie'@fr , 'Geriatrics'@en ;
        

            skos:definition 'Branche de la médecine concernant les aspects physiologiques et pathologiques des personnes âgées, y compris les problèmes cliniques de sénescence et de sénilité.'@fr, 'The branch of medicine concerned with the physiological and pathological aspects of the aged, including the clinical problems of senescence and senility.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/d37e4d8c-a978-40c7-ba4f-eee841851073' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D005853' ;
                            

        dct:identifier 'FHT7111' .
    

        term:FHT1042 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Gynécologie et obstétrique'@fr , 'Gynaecology and obstetrics'@en ;
        

            skos:definition 'Spécialité médicale et chirurgicale concernant la physiologie et les troubles principalement du tractus génital féminin, ainsi que de l\'endocrinologie féminine et de la physiologie de la reproduction. / Spécialité médicale et chirurgicale concernant la gestion et les soins des femmes pendant la grossesse, la parturition et le puerpérium.'@fr, 'A medical-surgical specialty concerned with the physiology and disorders primarily of the female genital tract, as well as female endocrinology and reproductive physiology. / A medical-surgical specialty concerned with management and care of women during pregnancy, parturition, and the puerperium.'@en ;
        

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/7de64596-5b0d-4977-8f98-b982ff2ec17d' ;
                            

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/284ca20c-beb4-4abe-99fa-ef4513358bad' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D006176' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D009774' ;
                            

        dct:identifier 'FHT1042' .
    

        term:FHT4966 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Hématologie'@fr , 'Hematology'@en ;
        

            skos:definition 'Spécialité médicale concernant la morphologie, la physiologie et la pathologie du sang et des tissus de formation sanguine.'@fr, 'A medical specialty concerned with morphology, physiology, and pathology of the blood and blood-forming tissues.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/9239f328-78c9-40a5-a0b9-8e66fd9b6245' ;
            

            skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D006402' ;
        

        dct:identifier 'FHT4966' .
    

        term:FHT5264 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Hépatologie'@fr , 'Hepatology'@en ;
        

            skos:definition 'Branche de la médecine qui traite du foie et de ses affections.'@fr, 'The branch of medicine that deals with the liver and its disorders.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/27c456a1-051a-42f6-b52a-3beff0487da7' ;
            

        dct:identifier 'FHT5264' .
    

        term:FHT6387 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Immunologie médicale'@fr , 'Clinical immunology'@en ;
        

            skos:definition 'Branche de la médecine prenant en charge et explorant les maladies liées à un dysfonctionnement du système immunitaire.'@fr, 'A branch of medicine that treats and studies diseases related to immune system dysfunction.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/7a3cf568-46ba-4840-be8f-f22fc030139f' ;
            

            skos:broadtMatch 'http://id.nlm.nih.gov/mesh/D000486' ;
        

        dct:identifier 'FHT6387' .
    

        term:FHT4835 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Infectiologie'@fr , 'Infectious disease medicine'@en ;
        

            skos:definition 'Branche de la médecine concernant le diagnostic et le traitement des maladies infectieuses.'@fr, 'The branch of medicine concerned with the diagnosis and treatment of infectious diseases.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/fa2ceeab-3b2f-45e9-9243-e5a8005b98de' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D055552' ;
                            

        dct:identifier 'FHT4835' .
    

        term:FHT9030 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine complémentaire et intégrative'@fr , 'Integrative and complementary medicine'@en ;
        

            skos:definition 'La médecine complémentaire et intégrative comprend des pratiques thérapeutiques qui ne sont actuellement pas considérées comme faisant partie intégrante de la pratique médicale allopathique conventionnelle.'@fr, 'Complementary and Integrative Medicine includes therapeutic practices which are not currently considered an integral part of conventional allopathic medical practice.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/c3c03909-fc4b-4082-9de2-3a105efcb1aa' ;
            

        dct:identifier 'FHT9030' .
    

        term:FHT8595 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine d’urgence'@fr , 'Emergency medicine'@en ;
        

            skos:definition 'Branche de la médecine concernant l\'évaluation et le traitement initial des problèmes médicaux urgents et émergents, tels que ceux causés par les accidents, les traumatismes, la maladie soudaine, l\'empoisonnement ou les catastrophes. Des soins médicaux d\'urgence peuvent être fournis à l\'hôpital ou sur des sites à l\'extérieur du centre médical.'@fr, 'The branch of medicine concerned with the evaluation and initial treatment of urgent and emergent medical problems, such as those caused by accidents, trauma, sudden illness, poisoning, or disasters. Emergency medical care can be provided at the hospital or at sites outside the medical facility.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/5e1591e2-d02b-436c-8216-6b8912eee467' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D004635' ;
                            

        dct:identifier 'FHT8595' .
    

        term:FHT2605 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine générale'@fr , 'General medicine'@en ;
        

            skos:definition 'Spécialité médicale fournissant les soins en première intention, dans une approche globale, continue et coordonnée, à travers les âges et les spécialités.'@fr, 'Medical specialty providing primary care, using a comprehensive, continuous and coordinated approach, across all ages and specialties.'@en ;
        

            skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/4b9f8efb-68dd-45a1-b04c-d23d457d6898' ;
            

            skos:closeMatch 'http://id.nlm.nih.gov/mesh/D058006' ;
        

        dct:identifier 'FHT2605' .
    

        term:FHT3518 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine interne'@fr , 'Internal medicine'@en ;
        

            skos:definition 'Spécialité médicale concernant diagnostic et le traitement de nombreuses maladies auto-immunes inflammatoires, systémiques (qui atteignent plusieurs organes) et orphelines.'@fr, 'Medical specialty concerning the diagnosis and treatment of numerous inflammatory, systemic (affecting multiple organs) and orphan autoimmune diseases.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/0d45044a-74d5-4bd7-b920-b92af3388576 ' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D007388' ;
                            

                skos:relatedMatch 'http://data.europa.eu/8mn/euroscivoc/f0844378-9f30-4873-b19b-5bff8c184a36' ;
            

        dct:identifier 'FHT3518' .
    

        term:FHT4634 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine physique et de réadaptation'@fr , 'Physical and Rehabilitation Medicine'@en ;
        

            skos:definition 'Spécialité médicale qui traite des affections qui compromettent la mobilité du patient, par le biais des soins de rééducation et de réadaptation nécessaires après une intervention chirurgicale ou une maladie, visant à prévenir ou réduire les conséquences fonctionnelles physiques, psychologiques, sociales et économiques des déficiences et des incapacités.'@fr, 'A medical specialty that treats conditions that compromise a patient\'s mobility through the rehabilitation and recovery care required after surgery or illness, with the aim of preventing or reducing the physical, psychological, social and economic consequences of impairments and disabilities.'@en ;
        

            skos:exactMatch 'http://id.nlm.nih.gov/mesh/D010810' ;
            

                skos:relatedMatch 'http://data.europa.eu/8mn/euroscivoc/38e57437-b2cc-4d26-a46e-c5b639c01e5f' ;
            

        dct:identifier 'FHT4634' .
    

        term:FHT9149 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine régénérative'@fr , 'Regenerative medicine'@en ;
        

            skos:definition 'Domaine de médecine concernant le développement et l\'utilisation de stratégies visant à réparer ou remplacer des organes, des tissus et des cellules endommagés, malades ou métaboliquement déficients. Elle mobilise des thérapies innovantes telles que transplantation cellulaire et cellules souches, organes artificiels et organes et tissus bioartificiels, etc.'@fr, 'A field of medicine concerned with developing and using strategies aimed at repair or replacement of damaged, diseased, or metabolically deficient organs, tissues, and cells via tissue engineering; cell transplantation; and artificial organs and bioartificial organs and tissues.'@en ;
        

            skos:exactMatch 'http://id.nlm.nih.gov/mesh/D044968' ;
            

                skos:relatedMatch 'http://data.europa.eu/8mn/euroscivoc/495b214f-06c8-45b9-a5d2-64e2df5dc2e3' ;
            

        dct:identifier 'FHT9149' .
    

        term:FHT5830 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Médecine tropicale'@fr , 'Tropical medicine'@en ;
        

            skos:definition 'Branche de la médecine concernant les maladies prévalentes dans les régions tropicales et subtropicales. Elle s’intéresse principalement aux pathologies infectieuses (souvent épidémiques), nutritionnelles, et plus rarement génétiques, en tenant compte des spécificités environnementales (réservoirs, vecteurs), des déséquilibres alimentaires, des limites de l’offre médicale, ainsi que des conditions de vie et des facteurs socioculturels locaux.'@fr, 'The branch of medicine concerned with diseases prevalent in tropical and subtropical regions. It focuses primarily on infectious (often epidemic) and nutritional diseases, and more rarely genetic diseases, taking into account environmental specificities (reservoirs, vectors), dietary imbalances, limitations in medical care, as well as local living conditions and sociocultural factors. '@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/4cec15e9-0570-49e3-91d7-cebe00d0fadf' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D014330' ;
                            

        dct:identifier 'FHT5830' .
    

        term:FHT3469 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Néphrologie'@fr , 'Nephrology'@en ;
        

            skos:definition 'Spécialité médicale concernant l\'anatomie, la physiologie et la pathologie du rein.'@fr, 'A medical specialty concerned with the anatomy, physiology, and pathology of the kidney.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/3961e9d2-ab3b-451b-b246-20fc0ec3b0c4' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D009398' ;
                            

        dct:identifier 'FHT3469' .
    

        term:FHT5486 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Neurologie'@fr , 'Neurology'@en ;
        

            skos:definition 'Spécialité médicale concernant l\'étude des structures, des fonctions et des maladies du système nerveux.'@fr, 'A medical specialty concerned with the study of the structures, functions, and diseases of the nervous system.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/c4793dfe-e80e-49dd-9fcc-a1a742de1b25' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D009462' ;
                            

            skos:closeMatch 'http://data.europa.eu/8mn/euroscivoc/00a5c4f4-b7ee-41a4-bcdf-3a02e6be1660' ;
        

        dct:identifier 'FHT5486' .
    

        term:FHT2394 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Nutrition et diététique'@fr , 'Nutrition and dietetics'@en ;
        

            skos:definition 'Etude des processus nutritionnels ainsi que les composantes de la nourriture, leurs actions, leur interaction et leur équilibre par rapport à la santé et aux maladies.'@fr, 'The study of nutrition processes as well as the components of food, their actions, interaction, and balance in relation to health and disease.'@en ;
        

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/71cd7e43-dbf6-420f-8338-b444439e4e41' ;
                            

                                skos:narrowMatch 'http://data.europa.eu/8mn/euroscivoc/8190a2e4-d944-4a7e-bb2f-adb488442622' ;
                            

                                skos:narrowMatch 'http://id.nlm.nih.gov/mesh/D052756' ;
                            

        dct:identifier 'FHT2394' .
    

        term:FHT9042 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Odontologie'@fr , 'Dentistry'@en ;
        

            skos:definition 'Branche de la médecine concernant les dents, la cavité orale et les structures associées, ainsi que le diagnostic et le traitement de leurs maladies, y compris la prévention et la restauration de tissus défectueux et manquants.'@fr, 'The branch of medicine concerned with the teeth, oral cavity, and associated structures, and the diagnosis and treatment of their diseases including prevention and the restoration of defective and missing tissue.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/5754a839-d714-4849-9789-e831eb4af6f1' ;
                            

                                skos:exactMatch 'http://id.nlm.nih.gov/mesh/D003813' ;
                            

        dct:identifier 'FHT9042' .
    

        term:FHT7299 rdf:type owl:NamedIndividual, fresh:HealthTheme ;
            skos:prefLabel 'Oncologie'@fr , 'Oncology'@en ;
        

            skos:definition 'Spécialité médicale consacrée à l’étude, au diagnostic et au traitement des maladies cancéreuses.'@fr, 'Medical specialty dedicated to the study, diagnosis and treatment of cancerous diseases.'@en ;
        

