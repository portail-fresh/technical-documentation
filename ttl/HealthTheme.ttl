            skos:prefLabel 'Psychiatrie'@fr , 'Psychiatry'@en ;
        

            skos:definition 'Spécialité médicale qui traite de l\'origine, du diagnostic, de la prévention et du traitement des troubles mentaux.'@fr, 'A medical specialty concerned with the origin, diagnosis, prevention, and treatment of mental disorders.'@en ;
        

                                skos:exactMatch 'http://data.europa.eu/8mn/euroscivoc/3de50dee-da1c-4791-a386-56bca24a5fed' ;
                            

