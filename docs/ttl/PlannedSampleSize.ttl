    fresh:terminologies rdf:type owl:Class . 


    fresh:PlannedSampleSize rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dct:identifier term:FPS ;
        dct:title 'Nombre prévu de participants'@fr , 'Expected number of participants'@en ;
        dct:description 'Concepts utilisés pour décrire le champ PlannedSampleSize du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field PlannedSampleSize in the FReSH metadata schema.'@en ;
        dct:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'PlannedSampleSize';


        
 
        dct:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        term:FPS5792 rdf:type owl:NamedIndividual, fresh:PlannedSampleSize ;
            skos:prefLabel '< 500 individus'@fr , '< 500 individuals'@en ;
        

        dct:identifier 'FPS5792' .
    

        term:FPS3139 rdf:type owl:NamedIndividual, fresh:PlannedSampleSize ;
            skos:prefLabel '[500-1000[ individus'@fr , '[500-1000[ individuals'@en ;
        

        dct:identifier 'FPS3139' .
    

        term:FPS8915 rdf:type owl:NamedIndividual, fresh:PlannedSampleSize ;
            skos:prefLabel '[1000-10000[ individus'@fr , '[1000-10000[ individuals'@en ;
        

        dct:identifier 'FPS8915' .
    

        term:FPS3980 rdf:type owl:NamedIndividual, fresh:PlannedSampleSize ;
            skos:prefLabel '[10000-20000[ individus'@fr , '[10000-20000[ individuals'@en ;
        

        dct:identifier 'FPS3980' .
    

        term:FPS7458 rdf:type owl:NamedIndividual, fresh:PlannedSampleSize ;
            skos:prefLabel '>= 20000 individus'@fr , '>= 20000 individuals'@en ;
        

        dct:identifier 'FPS7458' .
    