@prefix dct: <http://purl.org/dc/terms/> .
    @prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
    @prefix fresh: <https://purl.org/fresh/> .
    @prefix term: <https://purl.org/fresh/terminologies/> .
    @prefix mesh: <http://id.nlm.nih.gov/mesh/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix vocab: <https://portail-fresh.fr/vocab/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix pav: <http://purl.org/pav/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    fresh:terminologies rdf:type owl:Class . 


    fresh:DocumentType rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dct:identifier term:FDT ;
        dct:title 'Type de document'@fr , 'Document Type'@en ;
        dct:description 'Concepts utilisés pour décrire le champ DocumentType du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field DocumentType in the FReSH metadata schema.'@en ;
        dct:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'DocumentType';


        
 
        dct:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        term:FDT4538 rdf:type owl:NamedIndividual, fresh:DocumentType ;
            skos:prefLabel 'Publication définissant la base de données et/ou son protocole de collecte (article présentant les données, profil de la cohorte, article sur la méthode ou le protocole, article de synthèse, note sur les données, rapport enregistré...).'@fr , 'Publication defining the database and/or its collection protocol  (data paper, cohort profile, method/protocol paper, resource paper, data note, registered report...).'@en ;
        

        dct:identifier 'FDT4538' .
    

        term:FDT6087 rdf:type owl:NamedIndividual, fresh:DocumentType ;
            skos:prefLabel 'Publication issue de l\'étude et présentant les résultats de la recherche (articles, posters, rapports, ouvrages ou chapitres...).'@fr , 'Publication resulting from the study and presenting research findings (articles, posters, reports, books or chapters, etc.).'@en ;
        

        dct:identifier 'FDT6087' .
    

        term:FDT6755 rdf:type owl:NamedIndividual, fresh:DocumentType ;
            skos:prefLabel 'Publication réutilisant les données collectées dans le cadre de cette étude.'@fr , 'Publication reusing data collected in this study.'@en ;
        

        dct:identifier 'FDT6755' .
    

        term:FDT6296 rdf:type owl:NamedIndividual, fresh:DocumentType ;
            skos:prefLabel 'Protocole de l\'étude.'@fr , 'Study protocol.'@en ;
        

        dct:identifier 'FDT6296' .
    