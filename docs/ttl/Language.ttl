    fresh:terminologies rdf:type owl:Class . 


    fresh:Language rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dct:identifier term:FLG ;
        dct:title 'Langue'@fr , 'Language'@en ;
        dct:description 'Concepts utilisés pour décrire les champs OriginLang et VersionLang du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the fields OriginLang and VersionLang in the FReSH metadata schema.'@en ;
        dct:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'OriginLang';


            
 
        fresh:metadataConcerned 'VersionLang';


            
 
        dct:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        term:FLG5933 rdf:type owl:NamedIndividual, fresh:Language ;
            skos:prefLabel 'Français'@fr , 'French'@en ;
        

        dct:identifier 'FLG5933' .
    

        term:FLG9023 rdf:type owl:NamedIndividual, fresh:Language ;
            skos:prefLabel 'Anglais'@fr , 'English'@en ;
        

