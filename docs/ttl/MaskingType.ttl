    fresh:terminologies rdf:type owl:Class . 


    fresh:MaskingType rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dct:identifier term:FMT ;
        dct:title 'Type d\'insu'@fr , 'Masking Type'@en ;
        dct:description 'Concepts utilisés pour décrire le champ MaskingType du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field MaskingType in the FReSH metadata schema.'@en ;
        dct:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'MaskingType';


        
 
        dct:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        term:FMT3704 rdf:type owl:NamedIndividual, fresh:MaskingType ;
            skos:prefLabel 'Avec insu (en aveugle)'@fr , 'Blinded'@en ;
        

            skos:definition 'Au moins une partie est tenue dans l\'ignorance de l\'intervention attribuée.'@fr, 'At least one party is unaware of the assigned intervention.'@en ;
        

        dct:identifier 'FMT3704' .
    

        term:FMT5335 rdf:type owl:NamedIndividual, fresh:MaskingType ;
            skos:prefLabel 'Ouvert'@fr , 'Open label'@en ;
        

            skos:definition 'Toutes les parties connaissent l\'intervention attribuée.'@fr, 'All parties know the assigned intervention.'@en ;
        

        dct:identifier 'FMT5335' .
    