@prefix dct: <http://purl.org/dc/terms/> .
    @prefix eur: <http://data.europa.eu/8mn/euroscivoc/> .
    @prefix fresh: <https://purl.org/fresh/> .
    @prefix term: <https://purl.org/fresh/terminologies/> .
    @prefix mesh: <http://id.nlm.nih.gov/mesh/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix vocab: <https://portail-fresh.fr/vocab/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix pav: <http://purl.org/pav/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    fresh:terminologies rdf:type owl:Class . 


    fresh:Datatype rdf:type owl:Class ;
        rdfs:subClassOf fresh:terminologies ;
        dct:identifier term:FDA ;
        dct:title 'Type de données'@fr , 'Data Type'@en ;
        dct:description 'Concepts utilisés pour décrire le champ Datatype du schéma de métadonnées FReSH.'@fr , 'Terms used to describe the field Datatype in the FReSH metadata schema.'@en ;
        dct:creator fresh: ;
        pav:createdOn "2026-01-05"^^xsd:date ;
        pav:lastUpdatedOn '2026-04-07' ;


    
 
        fresh:metadataConcerned 'Datatype';


        
 
        dct:license 'https://creativecommons.org/licenses/by-nc-sa/4.0/' .


            
        term:FDA6638 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données cliniques'@fr , 'Clinical data'@en ;
        

            skos:definition 'Informations recueillies directement lors de la prise en charge médicale d\\\'un patient (examens cliniques, diagnostics, traitements, symptômes, etc.).'@fr, 'Information collected directly during medical care of a patient (clinical examinations, diagnoses, treatments, symptoms, etc.).'@en ;
        

        dct:identifier 'FDA6638' .
    

        term:FDA6856 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données paracliniques (hors biologiques)'@fr , 'Paraclinical data (non-biological)'@en ;
        

            skos:definition 'Données issues d\'examens complémentaires à l\'examen clinique, comme l\'imagerie médicale ou l’électrophysiologie, à l’exclusion des examens biologiques.'@fr, 'Data from tests that complement clinical examination, such as medical imaging or electrophysiology, excluding biological tests.'@en ;
        

        dct:identifier 'FDA6856' .
    

        term:FDA7482 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données paracliniques (hors biologiques) : Imagerie'@fr , 'Paraclinical data (non-biological) : Imaging'@en ;
        

            skos:definition 'Ensemble des techniques permettant d’obtenir des images du corps humain à des fins diagnostiques ou de suivi (ex. : radiographie, IRM, échographie).'@fr, 'A set of techniques used to obtain images of the human body for diagnostic or monitoring purposes (e.g., X-ray, MRI, ultrasound).'@en ;
        

        dct:identifier 'FDA7482' .
    

        term:FDA2448 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données paracliniques (hors biologiques) : Anthropométrie'@fr , 'Paraclinical data (non-biological) : Anthropometry'@en ;
        

            skos:definition 'Mesures des dimensions et de la composition du corps humain (ex. : taille, poids, indice de masse corporelle, périmètre crânien).'@fr, 'Measurement of human body size and composition (e.g., height, weight, body mass index, head circumference).'@en ;
        

        dct:identifier 'FDA2448' .
    

        term:FDA9485 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données paracliniques (hors biologiques) : Exploration fonctionnelle'@fr , 'Paraclinical data (non-biological) : Function testing'@en ;
        

            skos:definition 'L\'exploration fonctionnelle couvre un certain nombre de procédures de diagnostic qui fournissent une évaluation de la valeur fonctionnelle d’un organe ou de sa capacité à remplir sa fonction physiologique.'@fr, 'Functional testing covers a number of diagnostic procedures providing an evaluation of an organ’s functional value or its capacity to fulfil its physiological function.'@en ;
        

        dct:identifier 'FDA9485' .
    

        term:FDA8921 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données paracliniques (hors biologiques) : Autre'@fr , 'Paraclinical data (non-biological) : Other'@en ;
        

            skos:definition 'Données ne correspondant pas aux catégories définies.'@fr, 'Data that do not fall into the defined categories.'@en ;
        

        dct:identifier 'FDA8921' .
    

        term:FDA1123 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données biologiques'@fr , 'Biological data'@en ;
        

            skos:definition 'Résultats issus de prélèvements biologiques comme le sang, l’urine ou les tissus (ex. : hémogrammes, dosages hormonaux).'@fr, 'Results obtained from biological samples such as blood, urine, or tissues (e.g., blood counts, hormone levels).'@en ;
        

        dct:identifier 'FDA1123' .
    

        term:FDA6942 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données socio-démographiques'@fr , 'Socio-demographic data'@en ;
        

            skos:definition 'Informations sur les caractéristiques sociales et démographiques des individus (âge, sexe, niveau d’éducation, profession, etc.).'@fr, 'Information about individuals’ social and demographic characteristics (age, sex, education level, occupation, etc.).'@en ;
        

        dct:identifier 'FDA6942' .
    

        term:FDA5329 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données environnementales / d\'exposition'@fr , 'Environmental / exposure data'@en ;
        

            skos:definition 'Données sur les expositions à des facteurs environnementaux (pollution, produits chimiques, climat, etc.) ou professionnels.'@fr, 'Data on exposure to environmental factors (pollution, chemicals, climate, etc.) or occupational hazards.'@en ;
        

        dct:identifier 'FDA5329' .
    

        term:FDA1621 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données comportementales'@fr , 'Behavioral data'@en ;
        

            skos:definition 'Informations sur les habitudes et comportements individuels (alimentation, activité physique, consommation de substances, etc.).'@fr, 'Information on individual habits and behaviors (diet, physical activity, substance use, etc.).'@en ;
        

        dct:identifier 'FDA1621' .
    

        term:FDA2968 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données géospatiales'@fr , 'Geospatial data'@en ;
        

            skos:definition 'Données localisées géographiquement, comme le lieu de résidence, les trajectoires ou les zones d’exposition.'@fr, 'Geographically referenced data such as residence location, movement trajectories, or exposure zones.'@en ;
        

        dct:identifier 'FDA2968' .
    

        term:FDA4988 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données économiques'@fr , 'Economic data'@en ;
        

            skos:definition 'Informations relatives aux aspects financiers associés aux soins de santé, ainsi que sur la situation économique des individus (revenus, dépenses, emploi, etc.).'@fr, 'Information on the financial aspects associated with healthcare, as well as on the economic situation of individuals (income, expenses, employment, etc.).'@en ;
        

        dct:identifier 'FDA4988' .
    

        term:FDA6004 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données génétiques / génomiques'@fr , 'Genetic / genomic data'@en ;
        

            skos:definition 'Données issues de l’analyse de l’ADN ou du génome d’un individu.'@fr, 'Data obtained from analysis of an individual\'s DNA or genome.'@en ;
        

        dct:identifier 'FDA6004' .
    

        term:FDA6533 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Données de santé rapportées par les participants de l\'étude'@fr , 'Participant-reported health data'@en ;
        

            skos:definition 'Informations concernant la santé fournies directement par les participants.'@fr, 'Health-related informations directly reported by study participants.'@en ;
        

        dct:identifier 'FDA6533' .
    

        term:FDA6414 rdf:type owl:NamedIndividual, fresh:Datatype ;
            skos:prefLabel 'Autre'@fr , 'Other'@en ;
        

            skos:definition 'À utiliser lorsque le type de données est connu, mais introuvable dans la liste.'@fr, 'Use when the datatype is known but cannot be found in the list.'@en ;
        

        dct:identifier 'FDA6414' .
    